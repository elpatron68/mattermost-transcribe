# Copy to .env and adjust if needed:
#   cp .env.example .env

TZ=Europe/Berlin

POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmuser
POSTGRES_DB=mattermost

# Mattermost Team Edition image tag — https://hub.docker.com/r/mattermost/mattermost-team-edition/tags
MATTERMOST_IMAGE_TAG=10.5.0

# Public URL used by the server and plugin tooling (make watch)
MM_SERVICESETTINGS_SITEURL=http://localhost:8065

# Host port for the web UI / API
MATTERMOST_PORT=8065

# Parakeet ASR (Transcribe plugin) — plugin URL: http://parakeet:5092
PARAKEET_IMAGE_TAG=latest
PARAKEET_PORT=5092
PARAKEET_API_KEY=dev-secret-key
# Scale down on smaller dev machines (README suggests 4g / 4 cpus on 8 GiB)
PARAKEET_MEM_LIMIT=8g
PARAKEET_CPUS=8
