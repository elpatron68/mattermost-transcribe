{
    "id": "de.medisoftware.mattermost-transcribe",
    "name": "Transcribe",
    "version": "0.1.0",
    "description": "Record voice in Mattermost, transcribe with on-premises Parakeet ASR, review the text, and post it as a channel message.",
    "homepage_url": "https://github.com/medisoftware/mattermost-transcribe#readme",
    "support_url": "https://github.com/medisoftware/mattermost-transcribe/issues",
    "release_notes_url": "https://github.com/medisoftware/mattermost-transcribe/releases",
    "icon_path": "assets/icon.svg",
    "min_server_version": "6.2.1",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "Configure the external Parakeet ASR server (Whisper-compatible API).",
        "footer": "Parakeet must be running separately, e.g. via Docker. See the plugin README for setup instructions.",
        "settings": [
            {
                "key": "ParakeetURL",
                "display_name": "Parakeet Server URL",
                "type": "text",
                "help_text": "Base URL of the Parakeet server, e.g. http://parakeet:5092",
                "placeholder": "http://localhost:5092",
                "default": "http://localhost:5092"
            },
            {
                "key": "ParakeetAPIKey",
                "display_name": "Parakeet API Key",
                "type": "password",
                "help_text": "Optional API key matching PARAKEET_API_KEY on the Parakeet server.",
                "default": ""
            },
            {
                "key": "DefaultLanguage",
                "display_name": "Default Language",
                "type": "text",
                "help_text": "ISO-639-1 language code sent to Parakeet (e.g. de, en).",
                "default": "de"
            },
            {
                "key": "MaxRecordingDuration",
                "display_name": "Max Recording Duration (seconds)",
                "type": "number",
                "help_text": "Maximum length of a voice recording before it is stopped automatically.",
                "default": 120
            }
        ]
    }
}
